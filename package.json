{
  "name": "@mecha/workspace",
  "version": "4.1.13",
  "private": true,
  "description": "Local-first multi-agent runtime",
  "scripts": {
    "build": "pnpm -r --filter '!@mecha/spa' --filter '!@mecha/integration' --filter '!@mecha/website' build",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:pkg": "vitest run --project",
    "test:integration": "vitest run --config vitest.integration.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "typecheck": "tsc -b",
    "build:publish": "bash scripts/build-publish.sh",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo",
    "lint": "eslint packages/*/src/",
    "docs:dev": "pnpm --filter @mecha/website dev",
    "docs:build": "pnpm --filter @mecha/website build"
  },
  "keywords": [
    "ai",
    "agent",
    "claude",
    "multi-agent",
    "runtime",
    "local-first"
  ],
  "author": "xiaolai",
  "license": "ISC",
  "packageManager": "pnpm@10.26.1",
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty"
    ],
    "overrides": {
      "express-rate-limit": ">=8.2.2",
      "minimatch": ">=10.2.3",
      "hono": ">=4.12.4",
      "@hono/node-server": ">=1.19.10"
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.83"
  }
}
