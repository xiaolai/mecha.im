{
  "language": "go",
  "framework": "vitepress",
  "docRoot": "docs/",
  "sourceDirectories": ["cmd/", "internal/"],
  "strictness": "warn",
  "stalenessThresholdDays": 30,
  "mappings": [
    { "source": "cmd/mecha/main.go", "doc": "docs/guide/index.md" },
    { "source": "internal/worker/**", "doc": "docs/guide/index.md" },
    { "source": "internal/cli/**", "doc": "docs/guide/index.md" }
  ],
  "exclude": [
    "node_modules/",
    "vendor/",
    "docs/.vitepress/dist/",
    "docs/.vitepress/cache/",
    "website/",
    ".git/",
    ".claude/",
    "*.lock",
    "dev-docs/",
    "**/*_test.go"
  ]
}
