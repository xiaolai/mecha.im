{
  "language": "go",
  "framework": "vitepress",
  "docRoot": "website/",
  "sourceDirectories": ["cmd/", "internal/"],
  "strictness": "warn",
  "stalenessThresholdDays": 30,
  "mappings": [
    { "source": "cmd/mecha/main.go", "doc": "website/guide/index.md" },
    { "source": "internal/cli/**", "doc": "website/guide/cli.md" },
    { "source": "internal/worker/config.go", "doc": "website/guide/workers.md" },
    { "source": "internal/worker/validate.go", "doc": "website/guide/workers.md" },
    { "source": "internal/worker/docker.go", "doc": "website/guide/workers.md" },
    { "source": "internal/worker/docker_inspect.go", "doc": "website/guide/cli.md" },
    { "source": "internal/worker/registry.go", "doc": "website/guide/architecture.md" },
    { "source": "internal/worker/secrets.go", "doc": "website/guide/secrets.md" },
    { "source": "internal/worker/health.go", "doc": "website/guide/workers.md" },
    { "source": "internal/worker/types.go", "doc": "website/guide/workers.md" },
    { "source": "internal/serve/**", "doc": "website/guide/server.md" },
    { "source": "internal/source/**", "doc": "website/guide/events.md" },
    { "source": "internal/event/**", "doc": "website/guide/events.md" },
    { "source": "internal/policy/**", "doc": "website/guide/policy.md" },
    { "source": "internal/adapter/**", "doc": "website/guide/workers.md" },
    { "source": "docker/**", "doc": "website/guide/architecture.md" }
  ],
  "exclude": [
    "node_modules/",
    "vendor/",
    "website/.vitepress/dist/",
    "website/.vitepress/cache/",
    ".git/",
    ".claude/",
    "*.lock",
    "dev-docs/",
    "**/*_test.go"
  ]
}
