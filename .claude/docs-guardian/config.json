{
  "language": "go",
  "framework": "hugo",
  "docRoot": "docs/content/",
  "sourceDirectories": ["cmd/", "internal/"],
  "strictness": "warn",
  "stalenessThresholdDays": 14,
  "mappings": [],
  "exclude": [
    "node_modules/",
    "vendor/",
    "dist/",
    "website/",
    ".git/",
    ".claude/",
    "*.lock",
    "dev-docs/"
  ]
}
