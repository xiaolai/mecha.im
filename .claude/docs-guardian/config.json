{
  "language": "typescript",
  "framework": "vitepress",
  "docRoot": "website/docs",
  "sourceRoots": ["packages/*/src"],
  "strictness": "warn",
  "stalenessThresholdDays": 30,
  "mappings": {
    "packages/core/src": "website/docs/reference/api/core.md",
    "packages/agent/src": "website/docs/reference/api/agent.md",
    "packages/runtime/src": "website/docs/reference/api/runtime.md",
    "packages/process/src": "website/docs/reference/api/process.md",
    "packages/service/src": "website/docs/reference/api/service.md",
    "packages/meter/src": "website/docs/reference/api/meter.md",
    "packages/connect/src": "website/docs/reference/api/connect.md",
    "packages/server/src": "website/docs/reference/api/server.md",
    "packages/mcp-server/src": "website/docs/reference/api/mcp-server.md",
    "packages/gateway/src": "website/docs/reference/api/gateway.md",
    "packages/sandbox/src": "website/docs/features/sandbox.md",
    "packages/bus/src": "website/docs/features/bus.md",
    "packages/workflow/src": "website/docs/features/workflow.md",
    "packages/observe/src": "website/docs/features/observability.md",
    "packages/teams/src": "website/docs/features/teams.md",
    "packages/cli/src/commands": "website/docs/reference/cli",
    "packages/spa/src": "website/docs/reference/components.md"
  },
  "exclude": [
    "**/__tests__/**",
    "**/dist/**",
    "**/node_modules/**",
    "packages/integration/**",
    "packages/*/src/index.ts",
    "packages/*/src/types.ts"
  ]
}
