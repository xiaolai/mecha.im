{
  "language": "go",
  "framework": "vitepress",
  "docRoot": "website/",
  "sourceDirectories": ["cmd/", "internal/", "docker/"],
  "strictness": "warn",
  "stalenessThresholdDays": 30,
  "mappings": [
    { "source": "cmd/mecha/main.go", "doc": "website/guide/index.md" },
    { "source": "internal/cli/**", "doc": "website/guide/cli.md" },
    { "source": "internal/workers/config.go", "doc": "website/guide/workers.md" },
    { "source": "internal/workers/validate.go", "doc": "website/guide/workers.md" },
    { "source": "internal/workers/docker.go", "doc": "website/guide/workers.md" },
    { "source": "internal/workers/docker_inspect.go", "doc": "website/guide/cli.md" },
    { "source": "internal/workers/registry.go", "doc": "website/guide/architecture.md" },
    { "source": "internal/workers/secrets.go", "doc": "website/guide/secrets.md" },
    { "source": "internal/workers/health.go", "doc": "website/guide/workers.md" },
    { "source": "internal/workers/types.go", "doc": "website/guide/workers.md" },
    { "source": "internal/serve/**", "doc": "website/guide/server.md" },
    { "source": "internal/source/**", "doc": "website/guide/events.md" },
    { "source": "internal/events/**", "doc": "website/guide/events.md" },
    { "source": "internal/policies/**", "doc": "website/guide/policy.md" },
    { "source": "internal/adapter/**", "doc": "website/guide/adapters.md" },
    { "source": "docker/**", "doc": "website/guide/installation.md" },
    { "source": "docker/runtime/backends/**", "doc": "website/guide/dual-agent.md" },
    { "source": "internal/workers/container.go", "doc": "website/guide/workers.md" },
    { "source": "internal/store/**", "doc": "website/guide/architecture.md" },
    { "source": "internal/writeback/**", "doc": "website/guide/architecture.md" },
    { "source": "internal/tasks/**", "doc": "website/guide/architecture.md" },
    { "source": "cmd/mecha-mcp/**", "doc": "website/guide/mcp-server.md" }
  ],
  "exclude": [
    "node_modules/",
    "vendor/",
    "website/.vitepress/dist/",
    "website/.vitepress/cache/",
    ".git/",
    ".claude/",
    "*.lock",
    "dev-docs/",
    "**/*_test.go"
  ]
}
